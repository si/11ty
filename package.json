{
  "name": "eleventy-high-performance-blog",
  "version": "5.0.2",
  "license": "MIT",
  "description": "A starter repository for a blog web site using the Eleventy static site generator.",
  "scripts": {
    "build-ci": "npm run js-build && eleventy && npm run test",
    "build": "npm run clean && npm run build-ci",
    "watch": "concurrently \"npm run serve\" \"npm run js-build-watch\" \"npm run test-watch\"",
    "serve": "npm run clean && eleventy --serve",
    "js-build": "rollup -c rollup.config.js",
    "js-build-watch": "rollup -c rollup.config.js -w",
    "debug": "DEBUG=* eleventy && npm run test",
    "test": "mocha test/test*.js",
    "test-watch": "mocha test/test*.js --watch --watch-files=test/*",
    "clean": "rm -Rf ./_site/posts/*",
    "youtube-sync": "node scripts/youtube-to-micro.js",
    "youtube-sync:dry": "node scripts/youtube-to-micro.js --dry-run"
  },
  "pre-push": [
    "build"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/11ty/eleventy-base-blog.git"
  },
  "bugs": {
    "url": "https://github.com/11ty/eleventy-base-blog/issues"
  },
  "homepage": "https://github.com/11ty/eleventy-base-blog#readme",
  "engines": {
    "node": "18.x"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@rollup/plugin-terser": "^1.0.0",
    "eleventy-plugin-local-images": "^0.4.1",
    "file-type": "^22.1.0",
    "fs-extra": "^11.4.0",
    "jsdom": "^30.0.1",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "netlify-plugin-cache": "^1.0.3",
    "pre-push": "^0.1.4",
    "shorthash": "0.0.2"
  },
  "dependencies": {
    "@ampproject/toolbox-optimizer": "^2.10.1",
    "any-shell-escape": "^0.1.1",
    "clean-css": "^5.3.3",
    "concurrently": "^10.0.5",
    "csp-hash-generator": "0.0.3",
    "csso": "^5.0.5",
    "datauri": "^4.1.0",
    "expect.js": "^0.3.1",
    "ffmpeg-static": "^5.3.0",
    "html-minifier": "^4.0.0",
    "image-size": "^2.0.4",
    "lru-cache": "^11.5.2",
    "mocha": "^12.0.1",
    "phin": "^3.7.1",
    "purge-from-html": "^1.0.3",
    "purgecss": "^8.0.0",
    "querystring": "^0.2.1",
    "rollup": "^4.63.3",
    "sharp": "^0.35.4",
    "touch": "^3.1.1",
    "twitter": "^1.7.1"
  }
}
