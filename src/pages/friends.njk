<p>{{ description }} Most of this crew hang out with me in the <a href="{{ '/ontheside/' | url }}">On The Side Slack</a> — that's the hook for this list, and it'll grow as it goes.</p>

<div class="friend-grid">
  {% for friend in friends %}
    <a class="friend-card" href="{{ friend.url }}" rel="noopener" target="_blank">
      {% if friend.photo %}
        <img class="friend-card__avatar" src="{{ friend.photo }}" alt="{{ friend.name }}" width="80" height="80">
      {% else %}
        <span class="friend-card__avatar friend-card__avatar--initials" aria-hidden="true">
          {{ friend.name | initials }}
        </span>
      {% endif %}
      <span class="friend-card__name">{{ friend.name }}</span>
      <span class="friend-card__domain">{{ friend.domain }}</span>
    </a>
  {% endfor %}
</div>
