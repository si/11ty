{% set habit = "solitaire" | getHabit %}

<p><a href="{{ '/habits/' | url }}">← All habits</a></p>

{% if habit %}
<p>{{ habit.description }} Source: {{ habit.source }}.</p>

{% if habit.personalBest %}
<p><em>The game's own all-time personal best (not necessarily set during a logged session here): score {{ habit.personalBest.score }}, time {{ habit.personalBest.durationSeconds | formatDuration }}, moves {{ habit.personalBest.moves }}.</em></p>
{% endif %}

<div id="habit-app" data-habit-app="detail" data-habit="solitaire">
  <noscript><p><em>Enable JavaScript to see logged deals, stats, and the trend chart here.</em></p></noscript>
</div>
{% else %}
<p>No data yet.</p>
{% endif %}
