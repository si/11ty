---
templateClass: tmpl-post
---
{% extends "layouts/post.njk" %}

{% block extraArticleHeader %}
  {% set status = reading.status %}
  <div class="book-card">
    {% if book.cover %}
      <img class="book-card__cover" src="{{ ('/img/reading/' + book.cover) | url }}" alt="Cover of {{ title }}" width="75" height="113" loading="lazy">
    {% endif %}
    <ul class="book-card__meta">
      <li><strong>{{ book.author }}</strong>{% if book.published %} ({{ book.published }}){% endif %}</li>
      {% if book.series %}<li>{{ book.series }}{% if book.seriesNumber %}, book {{ book.seriesNumber }}{% endif %}</li>{% endif %}
      {% if status == "to-read" %}
        <li>On the to-read list since <time datetime="{{ page.date | htmlDateString }}">{{ page.date | longPublishedDate }}</time></li>
      {% else %}
        {% if reading.started %}<li>Started <time datetime="{{ reading.started | htmlDateString }}">{{ reading.started | longPublishedDate }}</time></li>{% endif %}
        {% if reading.finished %}<li>Finished <time datetime="{{ reading.finished | htmlDateString }}">{{ reading.finished | longPublishedDate }}</time></li>{% endif %}
        {% if reading.rating %}<li aria-label="Rated {{ reading.rating }} out of 5">{{ "★".repeat(reading.rating) }}{{ "☆".repeat(5 - reading.rating) }}</li>{% endif %}
      {% endif %}
      {% if book.goodreadsUrl %}<li><a href="{{ book.goodreadsUrl }}" rel="noopener">View on Goodreads</a></li>{% endif %}
    </ul>
  </div>
{% endblock %}
