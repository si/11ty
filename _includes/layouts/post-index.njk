---
layout: layouts/base.njk
templateClass: tmpl-post
---

{% if description %}
<p>{{ description }}</p>
{% endif %}

{%- set postIndexes = [
  { title: "All posts", url: "/posts/" },
  { title: "Blog", url: "/blog/" },
  { title: "Asides", url: "/asides/" },
  { title: "Micro", url: "/micro/" },
  { title: "Weeknotes", url: "/weeknotes/" },
  { title: "Portfolio", url: "/portfolio/" },
  { title: "Reading", url: "/reading/" }
] %}
<nav class="post-index-nav" aria-label="Post categories">
{%- for item in postIndexes %}
  <a href="{{ item.url | url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.title }}</a>
{%- endfor %}
</nav>

<ul class="page-index">
{%- for post in collections[collectionName] | reverse %}
  <li>
    <a href="{{ post.url | url }}">{% if post.data.title %}{{ post.data.title }}{% else %}<code>{{ post.url }}</code>{% endif %}</a>
    <small>
      <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
    </small>
  </li>
{%- endfor %}
</ul>
